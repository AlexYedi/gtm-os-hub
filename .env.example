# --- GitHub (source: shipped work) ---
# Read token. WITHOUT it, dev renders a clearly-labelled fixture (no network).
# Fine-grained PAT, read-only "Contents" on AlexYedi/gtm-os is enough.
GITHUB_TOKEN=
GTM_OS_REPO=AlexYedi/gtm-os

# --- Linear (source: roadmap) — V1 ---
# Personal API key. Sent RAW (no "Bearer" prefix). WITHOUT it, the public roadmap counts
# degrade to an empty fixture → the map node renders INSTRUMENTING, never fake counts.
LINEAR_API_KEY=
# Public counts read from this team — the Hub's own SAFE board. Counts-only (no titles/URLs).
LINEAR_TEAM_KEY=YED
# Cockpit (private, auth-gated) full-fidelity board — Alex's operating team. Two config
# values, NEVER one: keeps a confidential project's cadence off the public map.
LINEAR_COCKPIT_TEAM_KEY=YED

# --- Cockpit gate (Tier 3, authed) — V1 ---
# Simple password gate for V0/V1; swap for Clerk if a second viewer needs in.
COCKPIT_PASSWORD=

# --- Supabase: GTM University learning plane ---
# PUBLIC read path (anon/publishable key; browser-safe — only public.v_public_* views are granted).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# PRIVATE write path (service_role; SECRET; cockpit + sync script only). Never NEXT_PUBLIC_, never committed.
# Supabase dashboard -> GTM_OS_HUB -> Settings -> API -> service_role.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: canonical MI graph (SEPARATE project) — /signal read path (YED-130) ---
# The MI graph (mi-canonical-prod) is a different Supabase project from GTM_OS_HUB. WITHOUT these,
# /signal stays INSTRUMENTING (no read path). Point at the canonical project's `signal_read` views
# (v_topic_movement, v_topic_intersections — counts-only, PII-safe by RLS + k>=5 suppression).
# ANON/publishable key, server-side. NEVER put a service_role/secret key here.
# Dev: point at the staging twin; prod (Vercel): canonical oicikjyzmxqfomrrqkvf.
# (SPINE_SUPABASE_* still read as a fallback during the rename — the old signal-spine is retiring.)
MI_SUPABASE_URL=
MI_SUPABASE_ANON_KEY=

# --- PostHog (product analytics) — public pages only, pageviews only ---
# Publishable project key (safe in the client bundle by design). Project: gtm_os_hub (US cloud).
# WITHOUT it, PostHog stays fully dormant (instrumentation-client.ts is env-gated).
# autocapture + session recording are OFF and /cockpit is excluded — see instrumentation-client.ts.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- PII egress denylist (confidential entities; kept OUT of public source) ---
# Comma-separated: employer, target accounts, prospect / hiring-manager names.
# Set in Vercel env + local .env only. assertPublicSafe() throws if any appear in a public payload.
PII_DENYLIST=
